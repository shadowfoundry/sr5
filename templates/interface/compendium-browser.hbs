<div class="sr-browser-wrapper">
<div class="sr-browser-layout">

  {{!-- Left sidebar: search, type checkboxes, filters --}}
  <aside class="sr-browser-sidebar">
    <div class="sr-browser-search">
      <i class="fas fa-search"></i>
      <input type="text" name="search" placeholder="{{localize 'SR5.Search'}}" value="{{searchText}}" autocomplete="off">
    </div>

    <div class="sr-browser-type-list">
      <label>{{localize 'SR5.Type'}}</label>
      <div class="sr-browser-type-checkboxes">
        {{#each itemTypes}}
        <label class="sr-browser-type-item {{#if this.selected}}active{{/if}}">
          <input type="checkbox" class="sr-browser-type-cb" data-type="{{this.key}}" {{#if this.selected}}checked{{/if}}>
          <i class="fas fa-sm {{this.icon}}"></i>
          <span>{{this.label}}</span>
          <span class="sr-browser-type-count">{{this.count}}</span>
        </label>
        {{/each}}
      </div>
    </div>

    {{#if filterDefs.length}}
    <div class="sr-browser-filters">
      <label>{{localize 'SR5.Filters'}}</label>
      {{#each filterDefs}}
      <div class="sr-browser-filter-group">
        <label>{{this.label}}</label>
        {{#if (eq this.type "select")}}
        <select data-filter-key="{{this.key}}">
          <option value="">—</option>
          {{#each this.choices}}
          <option value="{{this.key}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>
          {{/each}}
        </select>
        {{else if (eq this.type "boolean")}}
        <input type="checkbox" data-filter-boolean="{{this.key}}" {{#if this.checked}}checked{{/if}}>
        {{/if}}
      </div>
      {{/each}}
    </div>
    {{/if}}

    <div class="sr-browser-sidebar-actions">
      <button type="button" data-action="clearFilters">
        <i class="fas fa-eraser"></i> {{localize 'SR5.Clear'}}
      </button>
      <button type="button" data-action="refreshIndex">
        <i class="fas fa-sync"></i>
      </button>
    </div>
  </aside>

  {{!-- Right: results --}}
  <section class="sr-browser-results">
    <header class="sr-browser-results-header">
      <span class="sr-browser-count">{{shownCount}} / {{totalCount}}</span>
      {{#if buyers.length}}
      <div class="sr-browser-shop">
        <i class="fas fa-sm fa-cart-shopping"></i>
        <select data-shop-buyer>
          {{#unless buyer}}
          <option value="" selected>{{localize 'SR5.ShopChooseBuyer'}}</option>
          {{/unless}}
          {{#each buyers}}
          <option value="{{this.id}}" {{#if this.selected}}selected{{/if}}>{{this.name}}</option>
          {{/each}}
        </select>
        {{#if buyer}}
        <span class="sr-browser-shop-funds {{#if creationMode}}muted{{/if}}">{{buyer.funds}}&yen;</span>
        {{/if}}
        <label class="sr-browser-shop-creation" data-tooltip="{{localize 'SR5.ShopCreationModeHint'}}">
          <input type="checkbox" data-shop-creation {{#if creationMode}}checked{{/if}}>
          <span>{{localize 'SR5.ShopCreationMode'}}</span>
        </label>
      </div>
      {{/if}}
      <div class="sr-browser-sort">
        <a data-sort-key="name" class="{{#if (eq sortKey 'name')}}active{{/if}}">
          {{localize 'SR5.Name'}}
          {{#if (eq sortKey 'name')}}
            <i class="fas fa-sm {{#if (eq sortDirection 'asc')}}fa-sort-up{{else}}fa-sort-down{{/if}}"></i>
          {{/if}}
        </a>
        <a data-sort-key="type" class="{{#if (eq sortKey 'type')}}active{{/if}}">
          {{localize 'SR5.Type'}}
          {{#if (eq sortKey 'type')}}
            <i class="fas fa-sm {{#if (eq sortDirection 'asc')}}fa-sort-up{{else}}fa-sort-down{{/if}}"></i>
          {{/if}}
        </a>
      </div>
    </header>

    <ul class="sr-browser-results-list">
      {{#each results}}
      <li class="sr-browser-result" data-uuid="{{this.uuid}}" data-doc-name="{{this.docName}}" draggable="true" data-action="viewItem">
        <img class="sr-browser-result-img" src="{{this.img}}" alt="">
        <div class="sr-browser-result-content">
          <div class="sr-browser-result-row">
            <span class="sr-browser-result-name">{{this.name}}</span>
            <span class="sr-browser-result-type">
              <i class="fas fa-sm {{this.typeIcon}}"></i>
              {{this.typeLabel}}
            </span>
          </div>
          {{#if this.info}}
          <div class="sr-browser-result-info">{{this.info}}</div>
          {{/if}}
        </div>
        {{#if this.canBuy}}
        <div class="sr-browser-result-buy">
          <input type="number" class="sr-browser-buy-qty" min="1" value="1" aria-label="{{localize 'SR5.Quantity'}}">
          <button type="button" data-action="addToCart" class="sr-browser-cart-add"
                  data-tooltip="{{localize 'SR5.ShopAddToCart'}}">
            <i class="fas fa-sm fa-cart-plus"></i>
          </button>
          <button type="button" data-action="buyItem" class="{{#if this.tooExpensive}}too-expensive{{/if}}"
                  data-tooltip="{{localize 'SR5.ShopBuy'}}">
            <i class="fas fa-sm fa-coins"></i>
            <span>{{this.priceLabel}}</span>
          </button>
        </div>
        {{/if}}
      </li>
      {{else}}
      <li class="sr-browser-no-results">
        {{localize 'SR5.NoResults'}}
      </li>
      {{/each}}
    </ul>

    {{#if cartCount}}
    <section class="sr-browser-cart">
      <header>
        <i class="fas fa-sm fa-cart-shopping"></i>
        <span>{{localize 'SR5.ShopCart'}} ({{cartCount}})</span>
        <span class="sr-browser-cart-total {{#unless cartAffordable}}too-expensive{{/unless}}">{{cartTotalLabel}}</span>
        <button type="button" data-action="clearCart" data-tooltip="{{localize 'SR5.ShopClearCart'}}">
          <i class="fas fa-sm fa-trash"></i>
        </button>
      </header>
      <ul class="sr-browser-cart-list">
        {{#each cart}}
        <li class="sr-browser-cart-line" data-uuid="{{this.uuid}}">
          <img src="{{this.img}}" alt="">
          <span class="sr-browser-cart-name">{{this.name}}</span>
          <input type="number" class="sr-browser-cart-qty" min="1" value="{{this.quantity}}"
                 aria-label="{{localize 'SR5.Quantity'}}">
          <span class="sr-browser-cart-price">{{this.totalLabel}}</span>
          <button type="button" data-action="removeFromCart" data-tooltip="{{localize 'SR5.ShopRemoveFromCart'}}">
            <i class="fas fa-sm fa-xmark"></i>
          </button>
        </li>
        {{/each}}
      </ul>
      <footer>
        <button type="button" data-action="checkoutCart" {{#unless canCheckout}}disabled{{/unless}}
                class="{{#unless cartAffordable}}too-expensive{{/unless}}">
          <i class="fas fa-sm fa-receipt"></i>
          {{#if creationMode}}{{localize 'SR5.ShopCheckoutFree'}}{{else}}{{localize 'SR5.ShopCheckout'}}{{/if}}
        </button>
      </footer>
    </section>
    {{/if}}

    {{#if hasMore}}
    <footer class="sr-browser-footer">
      <button type="button" class="sr-browser-load-more">
        {{localize 'SR5.LoadMore'}} ({{shownCount}} / {{totalCount}})
      </button>
    </footer>
    {{/if}}
  </section>

</div>
</div>
