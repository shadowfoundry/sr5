<nav class="tabs" data-group="gauche">
    {{> systems/sr5/templates/actors/_partials/header/navParts/coreInfos.hbs}}
    {{> systems/sr5/templates/actors/_partials/header/navParts/derived.hbs}}
    {{> systems/sr5/templates/actors/_partials/header/navParts/magicUser.hbs}}
</nav>

<div class="SR-MarginRight10 SR-MarginLeft10 SR-EspritType">
    <p class="SRTextInBox">{{findTranslation 'spiritTypes' system.type}}</p>
</div>

<div class="SRemptyBox">
    <input class="SRinputInBox" type="text" data-dtype="Number" name="system.force.base" value="{{system.force.base}}">
</div>

<div class="SR-Materialize"
  data-helpTitle="{{localize 'SR5.HELP_BoundedButton'}}" 
  data-helpMessage="{{localize 'SR5.HELP_BoundedButtonMsg'}}"
>
    <input id="boundedIcon" type="checkbox" name="system.isBounded" data-dtype="Boolean" {{checked system.isBounded}}>
    {{#if system.isBounded}}
    <label for="boundedIcon" class="active">{{> systems/sr5/assets/img/icons/nav-link.svg}}</label>
    {{else}}
    <label for="boundedIcon">{{> systems/sr5/assets/img/icons/nav-link.svg}}</label>
    {{/if}}
</div>

{{#ifne system.type 'watcher'}}
<div class="SR-Materialize" 
  title="{{localize 'SR5.Materializing'}}" 
  data-helpTitle="{{localize 'SR5.HELP_MaterializingButton'}}" 
  data-helpMessage="{{localize 'SR5.HELP_MaterializingButtonMsg'}}"
  >
  {{#if system.isMaterializing}}
  <input class="init-switch" id="materializeIcon" type="checkbox" name="system.isMaterializing" data-dtype="Boolean" data-binding="astralInit" {{checked system.isMaterializing}} {{#ife system.type 'homunculus'}}disabled{{/ife}}>
  <label for="materializeIcon" class="active">{{> systems/sr5/assets/img/icons/nav-materialize.svg}}</label>
  {{else}}
  <input class="init-switch" id="materializeIcon" type="checkbox" name="system.isMaterializing" data-dtype="Boolean" data-binding="physicalInit" {{checked system.isMaterializing}} {{#ife system.type 'homunculus'}}disabled{{/ife}}>
  <label for="materializeIcon">{{> systems/sr5/assets/img/icons/nav-materialize.svg}}</label>
  {{/if}}
</div>
{{/ifne}}

<!-- If we want to suppress actor from his sheet and "send it back" to his owner
{{#ifne system.creatorId ''}}
<div class="SR-Materialize">
    <a class="dismissActor">{{> systems/sr5/assets/img/icons/nav-dismiss.svg}}</a>
</div>
{{/ifne}}
-->