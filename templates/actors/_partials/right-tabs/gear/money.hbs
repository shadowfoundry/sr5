<!-- FINANCES -->
<div class="SRBlockSheet">
	<ul>
		<li class="SR-LigneEnTete grid">
			<div class="col-12 SR-TextUppercase">{{localize 'SR5.CharacterFinances'}}</div>
		</li>
		<li class="grid">
			<div class="col-2 SR-TextLeft {{#if (gt (lossModifiersSum system.nuyen) (gainModifiersSum system.nuyen))}}incomplete{{/if}}">{{localize 'SR5.CurrentNuyens'}}{{localize 'SR5.Colons'}}</div>
			<div class="col-2 SR-TextLeft">{{nuyen (minus (gainModifiersSum system.nuyen) (lossModifiersSum system.nuyen))}}</div>
			<div class="col-2 SR-TextCenter">{{localize 'SR5.TotalGainedNuyens'}}{{localize 'SR5.Colons'}}</div>
			<div class="col-2 SR-TextCenter">{{nuyen (gainModifiersSum system.nuyen)}}</div>
			<div class="col-2 SR-TextRight">{{localize 'SR5.TotalSpentNuyens'}}{{localize 'SR5.Colons'}}</div>
			<div class="col-2 SR-TextRight">{{nuyen (lossModifiersSum system.nuyen)}}</div>
		</li>
	</ul>
</div>

<!-- LIQUIDE : CREDITUBES -->
<div class="SRBlockSheet">
	<ul>
		<li class="SR-LigneEnTete grid">
			<div class="col-9 SR-TextUppercase">{{localize 'SR5.CharacterCash'}}</div>
			<div class="col-3 SR-TextRight">{{nuyen actor.cashOnHand}}</div>
		</li>
		{{#each actor.credsticks}}
		<li class="item grid" data-item-id="{{_id}}">
			<div class="col-5 deplie">{{name}}</div>
			<div class="col-3 SR-TextCenter">
				{{nuyen system.funds.value}}{{#if system.funds.max}} / {{nuyen system.funds.max}}{{/if}}
			</div>
			<div class="col-4 SR-TextRight">
				{{#if @root.owner}}
				<a class="credstick-withdraw" data-item-id="{{_id}}" data-tooltip="{{localize 'SR5.CredstickWithdraw'}}">
					<em class="fas fa-arrow-down-to-line"></em>
				</a>
				<a class="credstick-deposit" data-item-id="{{_id}}" data-tooltip="{{localize 'SR5.CredstickDeposit'}}">
					<em class="fas fa-arrow-up-from-line"></em>
				</a>
				{{/if}}
			</div>
		</li>
		{{else}}
		<li class="grid">
			<div class="col-12 SR-TextCenter SR-TextItalic">{{localize 'SR5.CredstickNone'}}</div>
		</li>
		{{/each}}
	</ul>
</div>

<!-- GAINS  -->
<div class="SRBlockSheet">
	<ul>
		<li class="SR-EnTete grid">
			<div class="col-8 filterNuyenGains SR-TextUppercase unfoldDark">{{localize 'SR5.CharacterGains'}}</div>
			<div class="col-3 SR-TextCenter">{{localize 'SR5.GainedAmount'}}</div>
			<div class="col-1">
				{{#if owner}}
				<p class="SR-TextRight add-item" data-helpTitle="{{localize 'SR5.HELP_ItemAdd' key=(localize 'SR5.NuyenGain_F')}}"
				data-helpMessage="{{localize 'SR5.HELP_ItemAddMsg'}}">
					<a class="item-create" data-title="{{localize 'SR5.Add'}}" data-type="itemNuyen" data-subtype="gain"><em class="fas fa-plus"></em></a>
				</p>
				{{/if}}
			</div>
		</li>
		{{#each actor.nuyens}}
		{{#ife system.type 'gain'}}
		<li class="item grid" data-item-id="{{_id}}" draggable="true">
			<div class="col-8 deplie" data-helpTitle="{{localize 'SR5.HELP_NuyenGainName' key=name}}"
			data-helpMessage="{{localize 'SR5.HELP_NuyenGainNameMsg'}}">
				<p class="SR-PaddingRight3 {{#if (missing system.amount)}}incomplete{{/if}}">
					<input data-item-id="{{_id}}" data-dtype="String" data-binding="name" type="text" class="edit-value" name="nuyen.{{_id}}.name" value="{{name}}" onfocus="this.select()">
				</p>
			</div>
			<div class="col-3 SR-TextCenter" data-helpTitle="{{localize 'SR5.HELP_NuyenAmountName' key=name}}"
			data-helpMessage="{{localize 'SR5.HELP_NuyenAmountNameMsg'}}">
				<input data-item-id="{{_id}}" data-dtype="Number" data-binding="system.amount" type="text" class="edit-value" name="nuyen.{{_id}}.amount" value="{{system.amount}}" onfocus="this.select()">
			</div>
			<div class="col-1 grid SR-TextRight">
				{{#if ../owner}}
				<a data-helpTitle="{{localize 'SR5.HELP_ItemManagement' key=name}}" data-helpMessage="{{localize 'SR5.HELP_ItemManagementMsg'}}">
					<em class="fas fa-sm fa-edit item-management"></em>
				</a>
				{{/if}}
			</div>
		</li>
		{{/ife}}
		{{/each}}
	</ul>
</div>

<!-- EXPENSES  -->
<div class="SRBlockSheet">
	<ul>
		<li class="SR-EnTete grid">
			<div class="col-8 filterNuyenExpenses SR-TextUppercase unfoldDark">{{localize 'SR5.CharacterExpenses'}}</div>
			<div class="col-3 SR-TextCenter">{{localize 'SR5.SpentAmount'}}</div>
			<div class="col-1">
				{{#if owner}}
				<p class="SR-TextRight add-item" data-helpTitle="{{localize 'SR5.HELP_ItemAdd' key=(localize 'SR5.NuyenLoss_F')}}"
				data-helpMessage="{{localize 'SR5.HELP_ItemAddMsg'}}">
					<a class="item-create" data-title="{{localize 'SR5.Add'}}" data-type="itemNuyen" data-subtype="loss"><em class="fas fa-plus"></em></a>
				</p>
				{{/if}}
			</div>
		</li>
		{{#each actor.nuyens}}
		{{#ife system.type 'loss'}}
		<li class="item grid" data-item-id="{{_id}}" draggable="true">
			<div class="col-8 deplie" data-helpTitle="{{localize 'SR5.HELP_NuyenExpenseName' key=name}}"
			data-helpMessage="{{localize 'SR5.HELP_NuyenExpenseNameMsg'}}">
				<p class="SR-PaddingRight3 {{#if (missing system.amount)}}incomplete{{/if}}">
					<input data-item-id="{{_id}}" data-dtype="String" data-binding="name" type="text" class="edit-value" name="nuyen.{{_id}}.name" value="{{name}}" onfocus="this.select()">
				</p>
			</div>
			<div class="col-3 SR-TextCenter" data-helpTitle="{{localize 'SR5.HELP_NuyenAmountName' key=name}}"
			data-helpMessage="{{localize 'SR5.HELP_NuyenAmountNameMsg'}}">
				<input data-item-id="{{_id}}" data-dtype="Number" data-binding="system.amount" type="text" class="edit-value" name="nuyen.{{_id}}.amount" value="{{system.amount}}" onfocus="this.select()">
			</div>
			<div class="col-1 grid SR-TextRight">
				{{#if ../owner}}
				<a data-helpTitle="{{localize 'SR5.HELP_ItemManagement' key=name}}" data-helpMessage="{{localize 'SR5.HELP_ItemManagementMsg'}}">
					<em class="fas fa-sm fa-edit item-management"></em>
				</a>
				{{/if}}
			</div>
		</li>
		{{/ife}}
		{{/each}}
	</ul>
</div>