<!-- REPUTATION -->
<div class="SRBlockSheet">
	<ul>
		<li class="SR-LigneEnTete grid">
			<div class="col-12 SR-TextUppercase">{{localize 'SR5.CharacterReputation'}}</div>
		</li>
		<li class="grid">
			<div class="col-12"></div>
		</li>
		<li class="grid">
			<div class="col-4 SR-TextLeft">
				<span class="col-auto">{{localize 'SR5.ReputationStreetCred'}}{{localize 'SR5.Colons'}}</span>
				<span class="col-auto"
				  data-helpTitle="{{localize 'SR5.ReputationStreetCred'}}"
				  data-helpDetails="system.streetCred">
					{{system.streetCred.value}}
				</span>
			</div>
			<div class="col-4 SR-TextCenter">
				<span class="col-auto">{{localize 'SR5.ReputationNotoriety'}}{{localize 'SR5.Colons'}}</span>
				<span class="col-auto"
				  data-helpTitle="{{localize 'SR5.ReputationNotoriety'}}"
				  data-helpDetails="system.notoriety">
					{{system.notoriety.value}}
				</span>
			</div>
			<div class="col-4 SR-TextRight">
				<span class="col-auto">{{localize 'SR5.ReputationPublicAwareness'}}{{localize 'SR5.Colons'}}</span>
				<span class="col-auto"
				  data-helpTitle="{{localize 'SR5.ReputationPublicAwareness'}}"
				  data-helpDetails="system.publicAwareness">
					{{system.publicAwareness.value}}
				</span>
			</div>
		</li>
	</ul>
</div>

<!-- REPUTATION GAINS -->
<div class="SRBlockSheet">
	<ul>
		<li class="SR-EnTete grid">
			<div class="col-5">
				<p class="filterReputationGains SR-TextUppercase unfoldDark">{{localize 'SR5.ReputationGains'}}</p>
			</div>
			<div class="col-3">
				<p class="SR-TextCenterOverflow">{{localize 'SR5.ReputationCategory'}}</p>
			</div>
			<div class="col-3">
				<p class="SR-TextCenterOverflow">{{localize 'SR5.Value'}}</p>
			</div>
			<div class="col-1">
				{{#if owner}}
				<p class="SR-TextRight add-item" data-helpTitle="{{localize 'SR5.HELP_ItemAdd' key=(localize 'SR5.ReputationGains')}}"
				data-helpMessage="{{localize 'SR5.HELP_ItemAddMsg'}}">
					<a class="item-create" data-title="{{localize 'SR5.Add'}}" data-type="itemReputation" data-subtype="gain">
						<em class="fas fa-plus"></em>
					</a>
				</p>
				{{/if}}
			</div>
		</li>
		{{#each actor.reputations}}
		{{#ife system.type 'gain'}}
		<li class="item grid" data-item-id="{{_id}}" draggable="true">
			<div class="col-5 deplie">
				<p class="SR-PaddingRight3 {{#if (missing system.amount)}}incomplete{{/if}}">
					<input data-item-id="{{_id}}" data-dtype="String" data-binding="name" type="text" class="edit-value" name="reputation.{{_id}}.name" value="{{name}}" onfocus="this.select()">
				</p>
			</div>
			<div class="col-3 SR-TextCenter SR-SelectCenter">
				<select data-item-id="{{_id}}" data-binding="system.reputationType" class="select-value" name="reputation.{{_id}}.reputationType" data-dtype="String">
					{{selectOptions ../system.lists.reputationTypes selected=system.reputationType localize=true}}
				</select>
			</div>
			<div class="col-3 SR-TextCenter">
				<input data-item-id="{{_id}}" data-dtype="Number" data-binding="system.amount" type="text" class="edit-value" name="reputation.{{_id}}.amount" value="{{system.amount}}" onfocus="this.select()">
			</div>
			{{#if ../owner}}
			<div class="col-1 SR-TextRight">
				<a data-helpTitle="{{localize 'SR5.HELP_ItemManagement' key=name}}" data-helpMessage="{{localize 'SR5.HELP_ItemManagementMsg'}}">
					<em class="fas fa-sm fa-edit item-management"></em>
				</a>
			</div>
			{{/if}}
		</li>
		{{/ife}}
		{{/each}}
	</ul>
</div>

