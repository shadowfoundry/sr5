<div>
	<div class="SR-mainContainer">

		<!-- HEADER -->
		{{> systems/sr5/templates/items/_partial/header/header-noEffect.hbs}}

		<!-- WINDOW BODY -->
		<div class="SR-MainWindows">
			<section class="sr-tabs">
				
				<!-- SUMMARY TAB -->
				<div class="tab grid" data-group="primary" data-tab="tab-info">
					<!-- SUMMARY -->
					<div class="col-5 SR-ItemColGauche">
						<ul>
							<!-- Summary title -->
							{{> systems/sr5/templates/items/_partial/title/summary.hbs}}
							<!-- LifeStyle summary -->
							{{> systems/sr5/templates/items/_partial/summary/lifestyle-summary.hbs}}
						</ul>
					</div>

					<!-- DESCRIPTION & GAME EFFECT -->
					<div class="col-7 SR-ItemColDroite">
						{{> systems/sr5/templates/items/_partial/editable/_common/descriptionGameEffect-edit.hbs}}
					</div>
				</div>

				<!-- EDITABLE TAB -->
				<div class="tab SR-ItemConfig SR_ItemScrollY" data-group="primary" data-tab="tab-stat">
					<!-- General Stat -->
					<ul>
						<!-- General information title -->
						{{> systems/sr5/templates/items/_partial/title/generalInformation.hbs}}
						<!-- Type -->
						{{> systems/sr5/templates/items/_partial/editable/lifestyle/type-edit.hbs}}
						<!-- Categories -->
						{{> systems/sr5/templates/items/_partial/editable/lifestyle/categories-edit.hbs}}
						<!-- Rent -->
						{{> systems/sr5/templates/items/_partial/editable/lifestyle/rent-edit.hbs}}
						<!-- Linked Identity -->
						{{> systems/sr5/templates/items/_partial/editable/lifestyle/linkedIdentity-edit.hbs}}
						<!-- Address, City, Country -->
						{{> systems/sr5/templates/items/_partial/editable/lifestyle/address-edit.hbs}}
					</ul>
					<!-- Options -->
					<ul class="SR-PaddingTop10">
						{{> systems/sr5/templates/items/_partial/editable/lifestyle/options-edit.hbs}}	
					</ul>
				</div>

			</section>
		</div>

		<!-- FOOTER -->
		<div class="SR-ItemFooter grid">
			<div class="col-12"></div>
				<div class="col-6">
					<span class="SR-TextUppercase SR-Bold">{{localize 'SR5.LifestyleType'}}{{localize 'SR5.Colons'}}</span>
					<span class="SR-TextUppercase SR-Bold">{{findTranslation 'lifestyleTypes' system.type}}</span>
				</div>
				<div class="col-6 SR-TextRight">
					<span class="SR-TextUppercase SR-Bold">{{localize 'SR5.RentCost'}}{{localize 'SR5.Colons'}}</span>
					<span class="SR-TextUppercase SR-Bold">{{system.price.value}}¥</span>
				</div>
		</div>

	</div>
</div>