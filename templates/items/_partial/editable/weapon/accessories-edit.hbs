<div class="SR-PaddingTop10">
    <ul>
        <li class="grid SR-EnTete">
            <div class="col-5 SR-TextUppercase">{{localize 'SR5.WeaponAccessories'}}</div>
            <div class="col-3">{{localize 'SR5.WeaponSlot'}}</div>
            <div class="col-3">
                <div class="grid">
                    <div class="col-8 SR-TextCenter">{{localize 'SR5.Price'}}</div>
                    <div class="col-4 SR-TextCenter">
                        {{localize 'SR5.Free'}}
                    </div>
                </div>
            </div>
            <div class="col-1 SR-TextRight">
                {{#if owner}}
                {{#if isEmbedded}}
                <a class="accessoryChoice" data-title="{{localize 'SR5.Add'}}" data-type="itemWeapon"><em class="fas fa-plus"></em></a>
                {{else}}
                <a class="subItem" data-title="{{localize 'SR5.Add'}}" data-binding="accessory" data-subaction="add"><em class="fas fa-plus"></em></a>
                {{/if}}
                {{/if}}
            </div>
        </li>
        {{#each system.accessory as |a i|}}
        <li class="subItemManagement grid" data-key="{{@key}}">
            <div class="col-5">
                {{#if a.system}}
                    {{a.name}}
                {{else}}
                <select name="system.accessory.{{i}}.name">
                {{#select name}}
                    <option value="">{{localize 'SR5.None'}}</option>
                    {{#each ../lists.weaponAccessories}}
                    <option value="{{@key}}">{{localize this}}</option>
                    {{/each}}
                {{/select}}
                </select>
                {{/if}}
            </div>
            <div class="col-3">
                {{#if a.system}}
                    {{#if a.system.weaponAccessory.slot}}
                        {{localize (lookup ../lists.weaponAccessorySlots a.system.weaponAccessory.slot)}}
                    {{/if}}
                {{else}}
                <select name="system.accessory.{{i}}.slot">
                {{#select slot}}
                    <option value="">{{localize 'SR5.None'}}</option>
                    {{#each ../lists.weaponAccessorySlots}}
                    <option value="{{@key}}">{{localize this}}</option>
                    {{/each}}
                {{/select}}
                </select>
                {{/if}}
            </div>
            <div class="col-3">
                <div class="grid">
                    <div class="col-8 SR-TextCenter">
                        {{#if a.isFree}}
                            -
                        {{else}}
                            {{a.price}}¥
                        {{/if}}
                    </div>
                    {{#if a.system}}
                    <div class="col-4 SR-TextCenter"><input type="checkbox" class="accessory-toggle" data-index="{{@key}}" data-field="isFree" {{checked isFree}} /></div>
                    {{else}}
                    <div class="col-4 SR-TextCenter"><input type="checkbox" name="system.accessory.{{i}}.isFree" data-dtype="Boolean" {{checked isFree}} /></div>
                    {{/if}}
                </div>
            </div>
            <div class="col-1 SR-TextRight"><a class="subItem" data-title="{{localize 'SR5.Delete'}}" data-index="{{@key}}" data-binding="accessory" data-subaction="delete"><i class="fas fa-trash"></i></a></div>
        </li>
        {{/each}}
    </ul>
</div>
