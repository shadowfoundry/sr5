<li class="SR-PaddingTop5 grid">
    <div class="col-11 SR-DialogOption">{{localize 'SR5.MatrixActionsOptions'}}</div>
</li>

<!-- NOISE -->
{{> systems/sr5/templates/rolls/rollDialogPartial/matrixNoiseModifier.hbs}}

<!-- GRID -->
{{#if dialogSwitch.publicGrid}}
    {{> systems/sr5/templates/rolls/rollDialogPartial/matrixGrid.hbs}}
{{/if}}
{{> systems/sr5/templates/rolls/rollDialogPartial/matrixTargetGrid.hbs}}


<!-- NORMAL ACTION OR INTERRUPTION: I Am the Firewall (Kill Code p. 43), or a Watchdog mark (Kill Code p. 45) -->
{{#if dialogSwitch.matrixActionType}}
<li class="grid">
    <div class="col-7">{{localize 'SR5.MatrixActionTypeChoice'}}{{localize 'SR5.Colons'}}</div>
    <div class="col-5 SR-TextRight">
        <select class="SR-ModSelect" data-target="matrixActionType" data-modifier="matrixActionType">
            <option value="{{combat.matrixActionTypeDefault}}" {{#unless (eq combat.matrixActionType "interruption")}}selected{{/unless}}>{{combat.matrixActionTypeLabel}}</option>
            <option value="interruption" {{#if (eq combat.matrixActionType "interruption")}}selected{{/if}}>{{localize 'SR5.ActionTypeInterruption'}} (-{{combat.interruptionInitiativeCost}} {{localize 'SR5.Initiative'}})</option>
        </select>
    </div>
</li>
{{/if}}

<!-- MARKS WANTED -->
{{#if (or (eq test.typeSub "hackOnTheFly") (eq test.typeSub "bruteForce"))}}
    {{> systems/sr5/templates/rolls/rollDialogPartial/markModifier.hbs}}
{{/if}}